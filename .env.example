# Copy to .env and fill in. Never commit .env.
#
# Nothing here is needed to run `pnpm test` — migrations and the whole core are
# tested against PGlite, an in-process Postgres that needs no service and no
# credentials. See docs/SETUP-REQUIRED.md for what each of these blocks.

# --- Database -------------------------------------------------------------
# Supabase. Hosted rather than local so the database follows you between machines.
#
# Use the SESSION POOLER string, not "Direct connection":
#   Direct    db.<ref>.supabase.co        IPv6 only — fails on most home networks
#   Session   ...pooler.supabase.com:5432  IPv4, persistent clients  <-- this one
#   Transaction  ...pooler.supabase.com:6543  for serverless/edge only
#
# Session pooler behaves like a direct connection: a connection you check out
# stays yours between statements, and session state persists on it. Both halves
# are load-bearing. withTransaction() and the migration runner each check one out
# and run a whole transaction on it, and the migration runner additionally holds
# a *session* advisory lock for its entire run so two deploys cannot apply the
# same files at once.
#
# The transaction pooler breaks that lock, and the way it breaks is worth
# knowing. It returns your connection to its own pool between transactions, so
# the lock guards nothing on the first run — and the unlock afterwards lands on
# a different backend, where it is a no-op that only WARNS. The lock strands.
# Every later run then refuses, loudly, blaming a concurrent run that does not
# exist. So the first symptom is not the failure; the second one is, and it
# points at the wrong thing.
#
# Shape: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# NOTE: there is deliberately no SUPABASE_URL / SUPABASE_ANON_KEY here.
#
# We never use supabase-js or the Data API (PostgREST). Every query goes through
# our own API routes over node-postgres. Because of that, the project is
# configured with all three controls, strongest first:
#
#   Data API               DISABLED  no PostgREST at all
#   Auto-expose new tables DISABLED  no grants, so tables are invisible to it
#   Automatic RLS          ENABLED   no policy, so rows are denied anyway
#
# Any one of those would be sufficient. The redundancy is deliberate: the day
# someone re-enables the Data API — a teammate, or you in six months — the safe
# defaults are already in place rather than one toggle away from exposing
# everything.
#
# Grants are what make a table reachable over the Data API; RLS only applies
# after a grant is satisfied. Our tables hold emails, wallet addresses, and join
# signatures, and the only legitimate reader is our own server.
#
# Expected side effect: the dashboard's Table Editor may not show rows, since it
# browses through PostgREST. The SQL Editor is unaffected.

# --- Stats providers ------------------------------------------------------
# Tank01 via RapidAPI. Primary feed: box scores, stats, news, injuries.
# Basic tier is free (1,000 calls/month) and covers development.
# Blocks: the stats adapter. Needed: Milestone B, before the Aug 22 draft.
TANK01_API_KEY=

# SportsDataIO. Gameday inactives AND the independent second oracle source that
# settlement requires. Blocks: inactives (Week 1) and settlement (Week 14).
SPORTSDATAIO_API_KEY=

# --- Rule set pinning -----------------------------------------------------
# A league's rules_uri must resolve or the on-chain hash anchors nothing.
# Pinata free tier is sufficient. Blocks: creating a real league.
PINATA_JWT=

# --- Solana ---------------------------------------------------------------
# Used for two things:
#
#   1. Drawing draft orders. The seed is the first block produced at or after a
#      league's scheduled draft time, so nobody can know it while teams are
#      still joining. About twenty RPC calls per league; any endpoint will do.
#   2. Later, the escrow program.
#
# NOTE: public nodes PRUNE old blocks. Drawing works fine — it happens seconds
# after the block exists — but verifying a draw months later needs an ARCHIVAL
# node. Matters before the playoffs, not in August. See docs/SETUP-REQUIRED.md.
SOLANA_RPC_URL=https://api.devnet.solana.com

# THE declaration of which chain this deployment is on: mainnet-beta, devnet,
# testnet or localnet. Everything else is checked against it.
#
# Joining checks the league's anchor is on THIS cluster. The on-chain address is
# a PDA derived from the league id, so it is identical everywhere — without this,
# a league anchored on devnet would satisfy a mainnet join and "the account
# exists" would be no answer at all.
#
# REQUIRED IN PRODUCTION. Unset, it is devnet in development and a refusal in
# production. It used to mean "do not check the cluster at all", so the one
# deployment nobody had configured was the one with no check.
#
# SOLANA_RPC_URL is verified against this by GENESIS HASH, not by reading its
# URL — a private RPC's hostname says nothing about which chain is behind it.
SOLANA_CLUSTER=devnet

# --- Email ----------------------------------------------------------------
# Sign-in is a link sent by email — no passwords to forget or leak.
#
# With these UNSET: in development the link is logged to the server console and
# shown in the UI, so the flow works locally. In production, requesting a link
# FAILS LOUDLY rather than pretending to have sent one — a sign-in that silently
# goes nowhere is indistinguishable from a broken account.
#
# Blocks: anyone signing in who is not sitting at the dev server.
# Needed: before anyone but you uses the app.
RESEND_API_KEY=
EMAIL_FROM=

# --- Scheduled jobs -------------------------------------------------------
# Six jobs, scheduled in apps/web/vercel.json. Anywhere else, point cron at the
# URLs. Vercel's Hobby plan caps cron at ONCE PER DAY and fails the deploy on a
# more frequent expression, so these schedules require Pro.
#
#   draft-tick   every minute   advances any draft whose pick clock ran out
#   stats        every 10 min   box scores into stat_lines
#   score-week   every 10 min   scores and finalises weeks, offset by 5
#   waivers      hourly         processes each league's due waiver run
#   trades       hourly         executes or expires accepted trades
#   season-sync  daily          schedule, player pool, byes, rankings, projections
#
# draft-tick MUST fire at least as often as the shortest pick clock — a minute,
# given the 90-second minimum. Without it a draft only advances when somebody
# has the page open, so a manager who goes to bed can come back to find their
# clock never ran.
#
# stats and score-week are offset rather than sharing a tick. score-week reads
# what stats writes, so firing them in the same minute means every scoring run
# uses the previous run's snapshot — no wrong answer, just ten minutes staler
# than it needs to be, including on the run that finalises a paying week.
#
# For four of the six this secret guards against the endpoint being hammered
# rather than against misuse: they only do what the clock already permits, so an
# unauthorised call cannot produce a wrong pick or a wrong score.
#
# For stats and season-sync it is doing more than that. Those two call a metered
# API, so an unauthorised caller spends money and can exhaust the daily quota —
# after which live scoring stops for everyone until it resets. Leave unset in
# development; the routes refuse rather than run open in production.
CRON_SECRET=

# --- Protocol fee -----------------------------------------------------------
#
# Where the 1% settlement fee is paid. See docs/RULES.md § 7.
#
# Server-side only, and never read from a request: a client-supplied recipient
# could redirect the fee, and a client-supplied rate could zero it.
#
# Unset in development means leagues are created with a zero fee, which is
# harmless locally. In production the pot-league route refuses rather than
# create leagues that give the fee away — league rules are frozen at creation,
# so a league created with the wrong recipient can never be corrected.
#
# Should be a multisig, not a personal wallet. Ideally the same one holding the
# program's upgrade authority.
FEE_RECIPIENT=

# The same address as FEE_RECIPIENT, exposed to the browser so the rules preview
# on the league-creation screen shows the fee that will actually be frozen.
#
# Set both together. If they disagree the server's value is the one that binds,
# so a mismatch is misleading rather than dangerous — but the preview is the
# whole promise of "you see the rules before you commit", so do not let it lie.
NEXT_PUBLIC_FEE_RECIPIENT=

# The key permitted to post a league's finalised scores on-chain.
#
# Settlement has exactly one trusted role — no contract can watch a football
# game — and this is it. It posts scores only: the contract derives the champion,
# the runner-up and the best record from them, so there is no instruction that
# takes a winner. It cannot change a rule, move a token, or pay anybody, and if
# it never acts every stake is returned at the refund unlock.
#
# It goes into the frozen rule set and members sign it, so it is shown above the
# join control. That also means it can never be changed for a league that
# already exists.
#
# **Point it at a multisig, not a raw key.** A Squads vault address derives from
# the multisig account, so the signers behind it can be changed without the
# address moving — which is the only way to recover from a lost or compromised
# key, since the value itself is frozen per league.
#
# **Required for pot leagues, in every environment.** Unlike FEE_RECIPIENT there
# is no sensible default: a league nobody may post scores for can never settle,
# and its members would wait out the timelock for money they should have won.
# The create route returns 503 rather than freezing that into a document.
SETTLEMENT_ORACLE=

# The same address, exposed to the browser so the rules preview on the
# league-creation screen shows the key that will actually be frozen. Set both
# together — the form compares the hash it previewed against the hash the server
# froze and refuses to go on if they differ.
NEXT_PUBLIC_SETTLEMENT_ORACLE=

# The browser's RPC endpoint. **Must match SOLANA_RPC_URL.**
#
# The commissioner's wallet signs against this one; the server verifies the
# resulting account against SOLANA_RPC_URL. If they differ, the league is
# anchored on one cluster and looked for on another — which surfaces as "no
# league account exists on-chain yet" and no amount of retrying fixes it.
#
# Optional. Unset, it is derived from NEXT_PUBLIC_SOLANA_CLUSTER below. Set it
# when you have a private RPC, which any real deployment does — the public nodes
# are rate-limited and the draft order draw alone makes ~30 sequential calls.
#
# It no longer falls back to mainnet-beta. A build with nothing configured used
# to point every wallet at real money while the server verified somewhere else.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Which chain the BROWSER build is for. Must name the same cluster as
# SOLANA_CLUSTER — they are separate variables only because NEXT_PUBLIC_* is
# inlined into the bundle at build time and the server's value is not.
#
# The two are cross-checked at runtime: the page asks its endpoint for a genesis
# hash and shows a "wrong network" banner when it disagrees with this. That is
# the only place the browser's chain becomes a fact rather than a convention,
# and the browser is where the signing happens.
#
# Unset, devnet — the fallback that fails visibly rather than expensively.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# The pot token on a LOCAL validator, and only there.
#
# Pot leagues are denominated in USDC, whose address differs per cluster, so the
# mint is a constant (`POT_MINTS` in packages/escrow/src/cluster.ts) rather than
# something a league creator sends — the same reasoning as FEE_RECIPIENT above.
# A caller-supplied mint is a mint the caller can pick for its freeze authority,
# and a frozen vault cannot be refunded.
#
# A local validator has no USDC, so there is nothing to pin: set this to a mint
# you created to exercise the pot flow end to end. Both variables must name the
# same mint, for the same reason the two cluster variables must agree — the
# browser previews the rules hash and the server freezes it.
#
# **Ignored on every public cluster.** Declaring mainnet and setting this does
# not widen mainnet; the value is simply not read. Unset, pot leagues are
# unavailable locally and everything else still works.
POT_MINT_LOCALNET=
NEXT_PUBLIC_POT_MINT_LOCALNET=

# Who may open the operator console at /ops/stats.
#
# Comma-separated email addresses, matched against the signed-in session's
# address. **Fails closed in every environment, including development** — unset,
# `isOperator` returns nobody and the page 404s for everyone, which is the safe
# direction for a screen that reports on the ingest.
#
# It also means an unset value is indistinguishable from "you are not an
# operator": there is no error and no hint, by design, because a 403 would
# confirm the page exists. If /ops/stats 404s for you and you expected it not
# to, this is the variable.
OPERATOR_EMAILS=
