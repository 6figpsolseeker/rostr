{
  "name": "rostr",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --build --force && pnpm --filter @rostr/web typecheck",
    "lint": "eslint .",
    "db:migrate": "pnpm --silent --filter \"./packages/**\" build && node --env-file-if-exists=.env packages/db/dist/cli.js migrate",
    "db:status": "pnpm --silent --filter \"./packages/**\" build && node --env-file-if-exists=.env packages/db/dist/cli.js status",
    "db:seed": "pnpm --silent --filter \"./packages/**\" build && node --env-file-if-exists=.env packages/db/dist/cli.js seed",
    "db:audit": "pnpm --silent --filter \"./packages/**\" build && node --env-file-if-exists=.env packages/db/dist/cli.js audit",
    "db:sync": "pnpm --silent --filter \"./packages/**\" build && node --env-file-if-exists=.env packages/db/dist/cli.js sync",
    "cron:status": "pnpm --silent --filter \"./packages/**\" build && node --env-file-if-exists=.env packages/db/dist/cli.js cron",
    "stats:check": "node --env-file-if-exists=.env packages/stats/dist/cli.js check",
    "stats:probe": "node --env-file-if-exists=.env packages/stats/dist/cli.js probe",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "test:program": "anchor test",
    "idl:sync": "node scripts/sync-idl.mjs",
    "idl:check": "node scripts/sync-idl.mjs --check",
    "test:web": "vitest run --config vitest.web.config.ts",
    "corpus:build": "pnpm --filter @rostr/core build && node scripts/build-corpus.mjs",
    "stats:corpus-sync": "node --env-file-if-exists=.env packages/stats/dist/cli.js corpus-sync && prettier --write --log-level warn \"packages/stats/src/tank01/__fixtures__/**/*.json\"",
    "corpus:stats": "pnpm --filter @rostr/core --filter @rostr/stats build && node scripts/build-stats-corpus.mjs && prettier --write --log-level warn \"packages/stats/src/tank01/__fixtures__/**/*.json\"",
    "test:bankrun": "vitest run --config vitest.bankrun.config.ts"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@eslint/js": "^10.0.1",
    "@solana/spl-token": "^0.4.15",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "solana-bankrun": "^0.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@rostr/escrow": "workspace:*"
  }
}
